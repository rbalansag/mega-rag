{
  "name": "@rbalansag/sdk",
  "version": "1.0.0",
  "description": "Runtime helpers for Mega RAG projects: env validation, telemetry events, and LLM prompt context.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "default": "./dist/env/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/index.d.ts",
      "default": "./dist/telemetry/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "default": "./dist/prompt/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbalansag/mega-rag.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
